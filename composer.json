{
  "name": "andisiahaan/digiflazz-php",
  "description": "Modern PHP client for Digiflazz API - Prepaid, Postpaid, PLN, and more",
  "type": "library",
  "homepage": "https://github.com/andisiahaan/digiflazz-php",
  "keywords": ["digiflazz", "payment", "pulsa", "pln", "api-client", "ppob", "topup"],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AndiSiahaan\\Digiflazz\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndiSiahaan\\Digiflazz\\Tests\\": "tests/"
    }
  },
  "support": {
    "issues": "https://github.com/andisiahaan/digiflazz-php/issues",
    "source": "https://github.com/andisiahaan/digiflazz-php"
  },
  "authors": [
    {
      "name": "Andi Saputra Siahaan",
      "email": "andisiahaan670@gmail.com",
      "homepage": "https://andipedia.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0",
    "mockery/mockery": "^1.6"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage",
    "analyse": "phpstan analyse",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
